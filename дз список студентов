    while True:
        numb = input('введите номер выбранного варианта')
        try:
            a = int(numb)
            if 1 <= a <= 10:
                return a
                break
        except:
            print('введите число')

def show_students():
    print(students)


def find_student():
    global students

    student_name = input('введите имя студента, которого хотите найти: ').capitalize()

    found = False
    index = 0
    student_list = list(students.items())

    while index < len(student_list):
        name, student_data = student_list[index]
        if name == student_name:
            print(name, student_data)
            found = True
            break
        index += 1
    else:
        if not found:
            print('такого студента нет.')


def del_student():
    student = input('введите имя студента, которого хотите удалить').capitalize()
    if student in students.keys():
        del (students[student])
        print('студент удалён')
        print(students)
        return students
    else:
        print('такого студента нет')


def append_grade():
    student_name = input('введите имя студента, которому хотите добавить оценку: ').capitalize()

    if student_name in students:
        while True:
            grade = input('введите оценку, которую хотите добавить: ')
            try:
                grade = int(grade)
                if 1 <= grade <= 5:
                    students[student_name]["grades"].append(grade)
                    print(f"оценка {grade} добавлена студенту {student_name}.")
                    print(students)
                    return students
                    break
                else:
                    print('оценка должна быть от 1 до 5.')
            except:
                print('пожалуйста, введите целое число.')
    else:
        print('такого студента нет.')

def older_students():
    while True:
        student_old = input('введите возраст: ')
        try:
            a = int(student_old)
            for key in students.keys():
                if students[key]["age"] > a:
                    print(key, students[key])
            break
        except:
            print('введите число')

def show_students_above_grade():
    global students
    while True:
        threshold_str = input("Введите порог оценки (целое число от 1 до 5): ")
        try:
            threshold = int(threshold_str)
            if 1 <= threshold <= 5:
                break
            else:
                print("Порог оценки должен быть целым числом от 1 до 5.")
        except ValueError:
            print("Пожалуйста, введите целое число.")

    found_students = False

    for name, student_data in students.items():
        if any(grade > threshold for grade in student_data["grades"]):
            print(f"Студент: {name}")
            print(f"  Возраст: {student_data['age']}")
            print(f"  Оценки: {student_data['grades']}")
            found_students = True

    if not found_students:
        print(f"Нет студентов с оценками выше {threshold}.")

def export_to_csv(filename="students.csv"):
    file = None
    try:
        file = codecs.open(filename, 'w', encoding='utf-8', errors='ignore')
        file.write(codecs.BOM_UTF8.decode('utf-8'))
        writer = csv.writer(file, delimiter=';', quoting=csv.QUOTE_MINIMAL)
        writer.writerow(["Имя", "Возраст", "Оценки"])

        for name, student_data in students.items():
            age = student_data["age"]
            grades = ",".join(map(str, student_data["grades"]))

            writer.writerow([name, age, grades])

        print(f"Список студентов успешно экспортирован в файл '{filename}'.")

    except Exception as e:
        print(f"Ошибка при экспорте в CSV: {e}")
    finally:
        if file:
            file.close()


def import_from_csv(filename="students.csv"):
    global students

    try:
        with open(filename, 'r', newline='', encoding='utf-8') as csvfile:
            reader = csv.reader(csvfile, delimiter=';', quoting=csv.QUOTE_MINIMAL)
            next(reader)

            for row in reader:
                if len(row) != 3:
                    print(f"Ошибка: Неверный формат строки в файле {filename}: {row}.  Строка пропущена.")
                    continue

                name, age_str, grades_str = row
                try:
                    age = int(age_str)
                    grades = [int(grade) for grade in grades_str.split(',')]
                    students[name] = {"age": age, "grades": grades}
                except ValueError:
                    print(f"Ошибка: Неверный формат данных в строке {row}.  Строка пропущена.")
                    continue

        print(f"Список студентов успешно импортирован из файла '{filename}'.")
        print(students)
    except FileNotFoundError:
        print(f"Ошибка: Файл '{filename}' не найден.")
    except Exception as e:
        print(f"Ошибка при импорте из CSV: {e}")

while True:
