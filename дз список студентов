import csv
import codecs

students = {
    "Иван": {"age": 20, "grades": [5, 4, 3]},
    "Аня": {"age": 19, "grades": [4, 4, 5]}
}

def add_student():
    global students

    name = input("Введите имя студента: ").capitalize()

    if name in students:
        print("Студент с таким именем уже существует.")
        return

    while True:
        age_str = input("Введите возраст студента: ")
        try:
            age = int(age_str)
            if age <= 0:
                print("Возраст должен быть положительным числом.")
            else:
                break
        except ValueError:
            print("Пожалуйста, введите целое число для возраста.")

    grades = []
    while True:
        grades_str = input("Введите оценки студента через запятую (например, 5,4,3): ")
        try:
            grades = [int(grade) for grade in grades_str.split(',')]
            # Добавляем проверку на допустимый диапазон оценок (например, от 1 до 5)
            if all(1 <= grade <= 5 for grade in grades):
                break  # Выходим из цикла, если оценки введены корректно
            else:
                print("Оценки должны быть целыми числами от 1 до 5.")
        except ValueError:
            print("Пожалуйста, введите целые числа для оценок, разделенные запятыми.")

    students[name] = {"age": age, "grades": grades}
    print(f"Студент {name} успешно добавлен.")
